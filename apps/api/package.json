{
  "name": "@career-maps/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:push": "prisma db push --skip-generate && prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/cli/seed.ts",
    "ingest": "tsx src/cli/ingest.ts",
    "rematch": "tsx src/cli/rematch.ts",
    "snapshot": "tsx src/cli/snapshot.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@career-maps/core": "*",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/oauth2": "^7.8.1",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "node-cron": "^3.0.3",
    "robots-parser": "^3.0.1",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "playwright": "^1.47.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.7.5",
    "@types/node-cron": "^3.0.11",
    "pino-pretty": "^11.3.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
