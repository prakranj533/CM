# Copy to apps/api/.env and edit as needed. Every value below has a working
# default except the OAuth and admin secrets.

DATABASE_URL="file:./dev.db"
PORT=4000
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000

# openssl rand -hex 32
SESSION_SECRET=dev-only-insecure-secret-change-me
SESSION_TTL_DAYS=30

# ----- scraper -----
# Identify the crawler honestly; some sites allow bots that declare themselves.
SCRAPER_USER_AGENT="CareerMapsBot/1.0 (+https://example.com/bot; respects robots.txt)"
# Politeness delay between requests to the same host.
SCRAPER_DELAY_MS=1200
SCRAPER_TIMEOUT_MS=20000
SCRAPER_MAX_PAGES=3
SCRAPER_MAX_JOBS_PER_SOURCE=200
# Leave true. Setting false skips robots.txt checks and is not recommended.
SCRAPER_RESPECT_ROBOTS=true

# Company job boards to pull (comma-separated slugs). The slug is the company id
# in its careers URL, e.g. boards.greenhouse.io/stripe -> "stripe".
# Verify a slug before adding it; companies migrate between ATS vendors and a dead
# slug just logs a warning and is skipped:
#   curl "https://boards-api.greenhouse.io/v1/boards/<slug>/jobs"
#   curl "https://api.lever.co/v0/postings/<slug>?mode=json"
GREENHOUSE_BOARDS=stripe,figma,discord,duolingo
LEVER_BOARDS=gopuff

# ----- scheduling -----
# Daily at 03:15. Empty string disables the scheduler.
INGEST_CRON="15 3 * * *"
# Run one ingest immediately on server boot (handy in development).
INGEST_ON_BOOT=false
# Required to call POST /api/admin/ingest. Empty disables the endpoint.
ADMIN_TOKEN=

# ----- Google OAuth (optional) -----
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
